<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GoPostal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        :root {
            --gp-blue: #1A365D;
            --gp-red: #E3242B;
            --gp-bg: #F4F6F9;
        }
        body { background-color: var(--gp-bg); font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .navbar { border-bottom: 3px solid var(--gp-red); background-color: #fff; }
        .navbar-brand { color: var(--gp-blue) !important; font-weight: 900; font-size: 24px; }
        .btn-gp-blue { background-color: var(--gp-blue); color: white; }
        .btn-gp-blue:hover { background-color: #0d1e36; color: white; }
        .btn-gp-red { background-color: var(--gp-red); color: white; }
        .btn-gp-red:hover { background-color: #b91d23; color: white; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light mb-5 shadow-sm">
        <div class="container">
            <a class="navbar-brand" href="/">GoPostal</a>
        </div>
    </nav>
    
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>