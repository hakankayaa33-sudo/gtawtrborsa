@{
    ViewData["Title"] = "GoPostal Takip Merkezi";
}

<style>
    /* Nefes Alan Logo Animasyonu */
    .breathing-logo {
        animation: breathing 2.5s ease-in-out infinite;
    }
    @@keyframes breathing {
        0% { transform: scale(0.9); opacity: 0.8; }
        50% { transform: scale(1.1); opacity: 1; }
        100% { transform: scale(0.9); opacity: 0.8; }
    }
    
    /* Timeline (Zaman Çizelgesi) Tasarımı */
    .timeline {
        border-left: 3px solid #e9ecef;
        padding-left: 20px;
        margin-left: 10px;
    }
    .timeline-item {
        position: relative;
        padding-bottom: 1.5rem;
    }
    .timeline-item:last-child {
        padding-bottom: 0;
    }
    .timeline-item::before {
        content: '';
        position: absolute;
        left: -28px;
        top: 4px;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background-color: var(--gp-red);
        border: 2px solid white;
        box-shadow: 0 0 0 2px var(--gp-red);
    }
    /* En sonki (en üstteki) hareketi mavi ve belirgin yap */
    .timeline-item:first-child::before {
        background-color: var(--gp-blue);
        box-shadow: 0 0 0 3px var(--gp-blue);
        width: 18px;
        height: 18px;
        left: -30px;
        top: 2px;
    }
</style>

<!-- Marka ve Hero Section: Sol Üst Logo -->
<div class="pt-4 ps-4">
    <img src="/gtawtr-go.webp" alt="GoPostal Logo" class="breathing-logo" style="width: 110px;" />
</div>

<div class="container pb-5">
    
    <!-- Ortalanmış Dikkat Çekici Başlık -->
    <div class="row justify-content-center mb-4 mt-2">
        <div class="col-md-8 text-center">
            <h1 style="color: var(--gp-blue); font-weight: 900; text-transform: uppercase;">GoPostal Gönderinizi Takip Edin</h1>
            <p class="text-muted fs-5 mt-2">Takip numaranızı girin ve kargonuzun her adımını canlı izleyin.</p>
        </div>
    </div>

    <!-- Arama Çubuğu -->
    <div class="row justify-content-center mb-5">
        <div class="col-md-8 col-lg-6">
            <div class="input-group input-group-lg shadow-sm">
                <input type="text" id="trackingNumber" class="form-control border-2 shadow-none py-3" placeholder="Takip Numaranızı Girin (Örn: GP-1001)" style="font-size: 18px;" />
                <button class="btn btn-gp-red px-5 fw-bold" id="btnTrack" type="button" style="font-size: 18px;">TAKİP ET</button>
            </div>
            <!-- Hata / Uyarı Mesajı -->
            <div id="alertMessage" class="alert d-none text-center fw-bold mt-3 shadow-sm" role="alert"></div>
        </div>
    </div>

    <!-- Yükleniyor (Loading Spinner) Ekranı -->
    <div id="loadingSpinner" class="text-center d-none mb-4">
        <div class="spinner-border" style="color: var(--gp-red); width: 3rem; height: 3rem;" role="status">
            <span class="visually-hidden">Sorgulanıyor...</span>
        </div>
        <h5 class="mt-3 fw-bold" style="color: var(--gp-blue);">Sistem Sorgulanıyor...</h5>
    </div>

    <!-- Sonuç Ekranı (Dinamik Render ve Timeline) -->
    <div id="tracking-results" class="row justify-content-center d-none">
        <div class="col-md-8 col-lg-6">
            
            <!-- Gönderi Özet Kartı -->
            <div class="card shadow border-0 rounded-3 mb-4" style="border-top: 4px solid var(--gp-blue);">
                <div class="card-body p-4">
                    <h4 class="fw-bold mb-3" style="color: var(--gp-blue);">Gönderi Detayları</h4>
                    <div class="row g-3">
                        <div class="col-6"><p class="mb-0 text-muted small">Takip No</p><h6 id="lblTrackingNo" class="fw-bold" style="color: var(--gp-red); font-size: 18px;"></h6></div>
                        <div class="col-6"><p class="mb-0 text-muted small">Ağırlık</p><h6 class="fw-bold"><span id="lblWeight"></span> kg</h6></div>
                        <div class="col-6"><p class="mb-0 text-muted small">Gönderen</p><h6 id="lblSender" class="fw-bold"></h6></div>
                        <div class="col-6"><p class="mb-0 text-muted small">Alıcı</p><h6 id="lblReceiver" class="fw-bold"></h6></div>
                        <div class="col-12"><p class="mb-0 text-muted small">Rota</p><h6 id="lblRoute" class="fw-bold"></h6></div>
                    </div>
                </div>
            </div>

            <!-- Timeline (Zaman Çizelgesi) Kartı -->
            <div class="card shadow border-0 rounded-3">
                <div class="card-body p-4">
                    <h4 class="fw-bold mb-4" style="color: var(--gp-blue);">Kargo Hareketleri</h4>
                    <div id="eventList" class="timeline">
                        <!-- JS ile Dinamik Doldurulacak -->
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('btnTrack').addEventListener('click', async () => {
            const trackingNumber = document.getElementById('trackingNumber').value.trim();
            const alertMessage = document.getElementById('alertMessage');
            const shipmentResult = document.getElementById('shipmentResult');
            const eventList = document.getElementById('eventList');
            const spinner = document.getElementById('loadingSpinner');

            // Arayüzü Sıfırla
            alertMessage.classList.add('d-none');
            trackingResults.classList.add('d-none');
            eventList.innerHTML = '';

            if (!trackingNumber) {
                alertMessage.className = 'alert alert-warning text-center fw-bold mt-3 shadow-sm';
                alertMessage.innerText = 'Lütfen geçerli bir takip numarası girin.';
                alertMessage.classList.remove('d-none');
                return;
            }

            // Yükleniyor (Spinner) Göster
            spinner.classList.remove('d-none');

            try {
                // Sayfa yenilenmeden asenkron API isteği
                const response = await fetch(`/Tracking/GetShipmentStatus?trackingNumber=${encodeURIComponent(trackingNumber)}`);
                const result = await response.json();

                // Spinner'ı Gizle
                spinner.classList.add('d-none');

                if (result.success) {
                    const data = result.data;
                    document.getElementById('lblTrackingNo').innerText = data.trackingNumber;
                    document.getElementById('lblSender').innerText = data.senderName;
                    document.getElementById('lblReceiver').innerText = data.receiverName;
                    document.getElementById('lblWeight').innerText = data.weight;
                    document.getElementById('lblRoute').innerText = `${data.origin} ➔ ${data.destination}`;

                    // Timeline Doldur
                    if (data.events && data.events.length > 0) {
                        data.events.forEach((e, index) => {
                            const dateObj = new Date(e.timestamp).toLocaleString('tr-TR');
                            // En güncel durum lacivert, geçmişteki durumlar kırmızı
                            const statusColor = index === 0 ? 'var(--gp-blue)' : 'var(--gp-red)';
                            
                            const listItem = `
                                <div class="timeline-item">
                                    <h5 class="mb-1 fw-bold" style="color: ${statusColor};">${e.status}</h5>
                                    <small class="text-muted d-block mb-2 fw-bold">${dateObj} &nbsp;|&nbsp; ${e.location}</small>
                                    <p class="mb-0 text-secondary">${e.description}</p>
                                </div>
                            `;
                            eventList.innerHTML += listItem;
                        });
                    } else {
                        eventList.innerHTML = '<p class="text-muted fst-italic">Bu gönderi için henüz bir hareket kaydı bulunmamaktadır.</p>';
                    }

                    trackingResults.classList.remove('d-none');
                } else {
                    alertMessage.className = 'alert alert-danger text-center fw-bold mt-3 shadow-sm';
                    alertMessage.innerText = result.message; // "Gönderi bulunamadı..." mesajı
                    alertMessage.classList.remove('d-none');
                }
            } catch (error) {
                spinner.classList.add('d-none');
                alertMessage.className = 'alert alert-danger text-center fw-bold mt-3 shadow-sm';
                alertMessage.innerText = 'Sorgulama sırasında sunucu tabanlı bir hata oluştu.';
                alertMessage.classList.remove('d-none');
            }
        });

        // Klavyedeki 'Enter' tuşu ile form gönderme (Kullanıcı Dostu - UX)
        document.getElementById('trackingNumber').addEventListener('keypress', function (e) {
            if (e.key === 'Enter') {
                document.getElementById('btnTrack').click();
            }
        });
    </script>
}